# Optional public ad configuration
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-XXXXXXXXXXXXXXXX

# PostHog browser analytics (public project token only)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog server-side Query API for the public /stats page
# Keep this value server-only; never prefix it with NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# Public site URL used by checkout and email links
PUBLIC_SITE_URL=https://letsvibecodeit.com

# Neon Postgres via the Vercel Neon integration (server-only)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@host/database?sslmode=require
NEON_PROJECT_ID=

# Stripe sponsorship checkout (server-only)
STRIPE_SECRET_KEY=

# Resend API for the digest audience and sponsor confirmations (server-only)
RESEND_API_KEY=

# Resend sender for confirmations and weekly digest (must be verified in Resend)
RESEND_FROM_EMAIL=LetsVibeCodeit <digest@example.com>

# Protects the Vercel Cron weekly digest endpoint
CRON_SECRET=replace-with-a-random-secret

# Local deployment credentials only. Never expose or commit real values.
VERCEL_TOKEN=
GITHUB_TOKEN=
